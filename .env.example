# Copy to .env.local and adjust. NEXT_PUBLIC_* values are inlined at build time,
# so rebuild after changing them.

# SeekKrr backend (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=https://api.seekkrr.com

# Partner/Creator Portal: Google sign-in, business and creator sign-up, business dashboard.
NEXT_PUBLIC_PARTNER_PORTAL_URL=https://creator.seekkrr.com
